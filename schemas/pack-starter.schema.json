{
  "title": "Carbonara starter factory (starters/*.yaml)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The factory's name; new documents are named after it."
    },
    "description": {
      "description": "One sentence on what the factory shows.",
      "type": "string"
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "recipe"
                  },
                  "recipe": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                  },
                  "building": {
                    "description": "One of the recipe's buildings; the recipe's first when left out.",
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                  },
                  "fields": {
                    "description": "Values of the pack plugin's node fields.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": [
                        "number",
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "pin": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "machines"
                          },
                          "count": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "type",
                          "count"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "rate"
                          },
                          "item": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                          },
                          "perSecond": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "type",
                          "item",
                          "perSecond"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "recipe"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "source"
                  },
                  "item": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                  },
                  "maxPerSecond": {
                    "description": "Most this source supplies; unlimited when left out.",
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "item"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "sink"
                  },
                  "item": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                  },
                  "targetPerSecond": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "item"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "junction",
                    "description": "Splits and merges flows: splitters, mergers, buses."
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "instance"
                  },
                  "blueprint": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "blueprint"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "port"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "in",
                      "out"
                    ]
                  },
                  "item": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                  }
                },
                "required": [
                  "kind",
                  "direction",
                  "item"
                ],
                "description": "A blueprint's boundary."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "note"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "text"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "frame"
                  },
                  "label": {
                    "type": "string"
                  },
                  "tone": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "label"
                ]
              }
            ]
          }
        },
        "edges": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "fromPort": {
                "type": "string",
                "minLength": 1
              },
              "toPort": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
              },
              "logistics": {
                "description": "Belt or pipe tier; limits the flow to its capacity.",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
              },
              "ratio": {
                "description": "Fixed share of the source node's output of this item.",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "from",
              "to",
              "item"
            ]
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    },
    "blueprints": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "graph": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "recipe"
                        },
                        "recipe": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                        },
                        "building": {
                          "description": "One of the recipe's buildings; the recipe's first when left out.",
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                        },
                        "fields": {
                          "description": "Values of the pack plugin's node fields.",
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": [
                              "number",
                              "string",
                              "boolean"
                            ]
                          }
                        },
                        "pin": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "machines"
                                },
                                "count": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              },
                              "required": [
                                "type",
                                "count"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "rate"
                                },
                                "item": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                                },
                                "perSecond": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              },
                              "required": [
                                "type",
                                "item",
                                "perSecond"
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "recipe"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "source"
                        },
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                        },
                        "maxPerSecond": {
                          "description": "Most this source supplies; unlimited when left out.",
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "kind",
                        "item"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "sink"
                        },
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                        },
                        "targetPerSecond": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "kind",
                        "item"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "junction",
                          "description": "Splits and merges flows: splitters, mergers, buses."
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "instance"
                        },
                        "blueprint": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "blueprint"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "port"
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "in",
                            "out"
                          ]
                        },
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                        }
                      },
                      "required": [
                        "kind",
                        "direction",
                        "item"
                      ],
                      "description": "A blueprint's boundary."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "note"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "text"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "frame"
                        },
                        "label": {
                          "type": "string"
                        },
                        "tone": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ]
                    }
                  ]
                }
              },
              "edges": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fromPort": {
                      "type": "string",
                      "minLength": 1
                    },
                    "toPort": {
                      "type": "string",
                      "minLength": 1
                    },
                    "item": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                    },
                    "logistics": {
                      "description": "Belt or pipe tier; limits the flow to its capacity.",
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
                    },
                    "ratio": {
                      "description": "Fixed share of the source node's output of this item.",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "item"
                  ]
                }
              }
            },
            "required": [
              "nodes",
              "edges"
            ]
          }
        },
        "required": [
          "name",
          "graph"
        ]
      }
    },
    "layout": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "locked": {
              "description": "Locked nodes stay put: dragging, nudging and arranging leave them.",
              "type": "boolean",
              "const": true
            },
            "tag": {
              "description": "A colour tag the user gave the node.",
              "type": "string",
              "enum": [
                "red",
                "orange",
                "yellow",
                "green",
                "blue",
                "purple"
              ]
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      }
    },
    "settings": {
      "default": {},
      "type": "object",
      "properties": {
        "rateUnit": {
          "type": "string",
          "enum": [
            "per_second",
            "per_minute",
            "per_hour"
          ]
        },
        "belt": {
          "description": "Show the rates of items this belt or pipe carries as multiples of its capacity (\"2 × Fast Conveyor\").",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(@[a-z0-9._-]+)?$"
        },
        "machineGroups": {
          "description": "How machine counts read: 4 × 100% + 1 × 37.5% (fill, the default) or 5 × 87.5% (even).",
          "type": "string",
          "enum": [
            "fill",
            "even"
          ]
        },
        "plugin": {
          "description": "Settings of the pack's plugin, e.g. a save profile.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    }
  },
  "required": [
    "name",
    "graph"
  ]
}
