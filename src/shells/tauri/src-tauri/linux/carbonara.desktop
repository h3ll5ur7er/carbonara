[Desktop Entry]
# Tauri's default entry, plus `%F` so a double-clicked file reaches the app, and the MIME types of the file
# associations in tauri.conf.json (registered by mime.xml).
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=application/x-carbonara;application/x-carbonara-pack;
