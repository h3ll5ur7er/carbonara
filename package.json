{
  "name": "carbonara",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:wasm && tsc && vite build",
    "build:wasm": "wasm-pack build crates/solver-wasm --target web --out-dir ../../src/engines/solver/wasm --out-name solver --no-pack",
    "preview": "vite preview",
    "tauri": "cd src/shells/tauri && tauri",
    "desktop:dev": "pnpm tauri dev",
    "desktop:build": "pnpm tauri build",
    "desktop:frontend": "pnpm build:wasm && vite build --config src/shells/tauri/vite.config.ts",
    "desktop:frontend:dev": "vite --config src/shells/tauri/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "tsx tools/schema.ts",
    "mcp:tools": "tsx tools/mcp-tools.ts",
    "carbonara-pack": "tsx tools/pack-cli/main.ts",
    "pack:build": "tsx tools/pack-cli/main.ts build",
    "pack:import": "tsx tools/pack-cli/main.ts import",
    "bench": "tsx bench/run.ts",
    "e2e:host": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.0",
    "cmdk": "1.1.1",
    "elkjs": "0.11.1",
    "fflate": "0.8.3",
    "html-to-image": "1.11.11",
    "immer": "11.2.9",
    "lucide-react": "1.56.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
